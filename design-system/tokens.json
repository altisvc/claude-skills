{
  "brand": "Altis",
  "version": "2.0",
  "last_updated": "2026-06-05",
  "two_systems_note": "Altis runs TWO coordinated visual systems. (1) WEB — the live product/marketing site (altisvc/web-v2): ABC Diatype / DM Sans / Freight Text Pro + a navy-slate neutral palette. (2) REPORTS / PRINT — Altis Reports PDFs and presentation decks: Inter Tight / Inter + the original brand palette, which render well for print. Brand blue (#015AE9) is shared. Use the WEB system for anything rendered in a browser; use the REPORTS system for PDFs, decks, and print. Where the designer's Figma and the v2 repo disagreed on the web system, the v2 repo won.",
  "sources": {
    "web": "altisvc/web-v2 implementation (hardcoded inline; near-duplicate hexes collapsed to plurality value). Re-derived 2026-06-05.",
    "reports": "Figma Brand Toolkit Shareout — figma_file_key NRmjBmJBIGJj5DTw3Lfe4a. Original system, unchanged.",
    "designer_figma": "https://www.figma.com/design/3s1c0lRwY14gfMKiS45JPa/Altis (node 458-820)"
  },

  "colors": {
    "web": {
      "_use": "Browser-rendered product and marketing surfaces only.",
      "brand": {
        "blue": { "hex": "#015AE9", "rgb": [1, 90, 233], "usage": "Hero brand color — primary CTA background, accent borders, highlight tints (rgba(1,90,233,0.05))" },
        "cyan": { "hex": "#02B3F4", "rgb": [2, 179, 244], "usage": "Accent only — uppercase eyebrow/kicker labels. Never a primary content background." }
      },
      "ink": {
        "900": { "hex": "#030D1F", "rgb": [3, 13, 31], "usage": "Darkest navy — dark backgrounds and max-contrast text" },
        "800": { "hex": "#081830", "rgb": [8, 24, 48], "usage": "Heading / high-emphasis text" },
        "700": { "hex": "#162840", "rgb": [22, 40, 64], "usage": "Primary body text — most common text color in the product" },
        "600": { "hex": "#2E4660", "rgb": [46, 70, 96], "usage": "Mid-tone sub-copy on light" }
      },
      "slate": {
        "500": { "hex": "#5C6F80", "rgb": [92, 111, 128], "usage": "Secondary / muted text — primary muted token" },
        "400": { "hex": "#7A8B9B", "rgb": [122, 139, 155], "usage": "Tertiary muted, eyebrow color, placeholders" },
        "300": { "hex": "#98A6B5", "rgb": [152, 166, 181], "usage": "Faint / disabled text" }
      },
      "surface": {
        "white": { "hex": "#FFFFFF", "rgb": [255, 255, 255], "usage": "Page background, reverse text, primary button text" },
        "page":  { "hex": "#F6F7FA", "rgb": [246, 247, 250], "usage": "Off-white section background; light text on dark surfaces" },
        "raised": { "hex": "#E8EDF5", "rgb": [232, 237, 245], "usage": "Card / panel surface on light" }
      },
      "border": {
        "default": { "hex": "#CBD4DF", "rgb": [203, 212, 223], "usage": "Border / divider" }
      },
      "semantic": {
        "positive":        { "hex": "#21A87A", "usage": "Positive / bull signal text (about-page variant: #1A9D6F)" },
        "positive-strong": { "hex": "#156634", "usage": "Positive accent — borders, strong headings" },
        "negative":        { "hex": "#E84040", "usage": "Negative / bear signal text (about-page variant: #D9482F)" },
        "negative-strong": { "hex": "#B52318", "usage": "Negative accent — borders, strong headings" },
        "danger":          { "hex": "#B84040", "usage": "UI destructive — destructive button bg, error text, focus ring" }
      }
    },

    "reports": {
      "_use": "Altis Reports PDFs and presentation decks — print-optimized. Unchanged original brand palette.",
      "core": {
        "navy":  { "hex": "#030F1F", "rgb": [3, 15, 31],   "usage": "Dark backgrounds, body text, headings" },
        "blue":  { "hex": "#015AE9", "rgb": [1, 90, 233],  "usage": "Hero brand color — CTAs, primary backgrounds, icon fills (shared with web)" },
        "cyan":  { "hex": "#01B2F4", "rgb": [1, 178, 244], "usage": "Secondary accent — highlights, links, data callouts" },
        "white": { "hex": "#FFFFFF", "rgb": [255, 255, 255], "usage": "Light backgrounds, reverse text, icon fills on dark" }
      },
      "secondary": {
        "purple": { "hex": "#814DC6", "usage": "Data viz, charts, accent" },
        "teal":   { "hex": "#00A6A6", "usage": "Data viz, supplemental UI" },
        "coral":  { "hex": "#FF6663", "usage": "Alerts, warm data viz accents" },
        "orange": { "hex": "#F28C59", "usage": "Warm accent, data viz" },
        "yellow": { "hex": "#F2DA3D", "usage": "Highlights, data viz" },
        "green":  { "hex": "#4BD66A", "usage": "Positive signals, data viz" }
      },
      "expanded": {
        "_note": "9 families × 3 tones (core/mid/light) for chart fills, data tables, supporting UI. Never primary brand expression.",
        "navy-dark": { "hex": "#030F1F" }, "navy-mid": { "hex": "#0A3166" }, "navy-light": { "hex": "#0F4A99" },
        "blue-core": { "hex": "#015AE9" }, "blue-mid": { "hex": "#4089FF" }, "blue-light": { "hex": "#AAC5F2" },
        "sky-core":  { "hex": "#01B2F4" }, "sky-mid":  { "hex": "#86D6F4" }, "sky-light":  { "hex": "#ACD6E5" },
        "teal-core": { "hex": "#00A6A6" }, "teal-mid": { "hex": "#60BFBF" }, "teal-light": { "hex": "#A3D9D9" },
        "purple-core": { "hex": "#814DC6" }, "purple-mid": { "hex": "#AD92D1" }, "purple-light": { "hex": "#DECEF2" },
        "coral-core":  { "hex": "#FF6663" }, "coral-mid":  { "hex": "#FF8987" }, "coral-light":  { "hex": "#FFC0BF" },
        "orange-core": { "hex": "#F28C59" }, "orange-mid": { "hex": "#F2A985" }, "orange-light": { "hex": "#FFCCB2" },
        "yellow-core": { "hex": "#F2DA3D" }, "yellow-mid": { "hex": "#F2E279" }, "yellow-light": { "hex": "#F2ECC2" },
        "green-core":  { "hex": "#4BD66A" }, "green-mid":  { "hex": "#82ED9A" }, "green-light":  { "hex": "#B8F5C5" }
      }
    }
  },

  "typography": {
    "web": {
      "_note": "web-v2 has no single heading font. ABC Diatype is the global default (body) and carries most headings; DM Sans is the most explicitly-applied font (UI + hero display); Freight Text Pro is a small serif accent only. Slightly blended — see brand-guidelines.md for the tightening recommendation.",
      "sans_font": {
        "family": "ABC Diatype", "role": "primary / global default", "css_var": "--font-abc-diatype",
        "source": "Licensed local webfont — public/fonts/abc-diatype-variable.woff2 (variable)",
        "use_for": "Body default (inherited everywhere), most headings, company names", "slides_safe": false
      },
      "ui_font": {
        "family": "DM Sans", "role": "secondary sans — most explicitly applied", "css_var": "--font-dm-sans-family",
        "source": "Google Fonts (variable)", "google_fonts_url": "https://fonts.google.com/specimen/DM+Sans",
        "use_for": "UI copy, forms, dialog body, labels, AND hero/display headlines", "slides_safe": true
      },
      "serif_font": {
        "family": "Freight Text Pro", "role": "small editorial accent", "css_var": "--font-freight-text-pro-book",
        "source": "Licensed local webfont — public/fonts/freight-text-pro-book.woff2",
        "use_for": "Source citations, signal links, footnotes (text-xs/sm). NOT a display serif.", "slides_safe": false
      },
      "web_fallback_stack": "var(--font-abc-diatype), ui-sans-serif, system-ui, -apple-system, sans-serif",
      "scales": {
        "display": { "size": 48, "mobile_size": 32, "weight": 400, "line_height": 1.4, "tracking": "0.24px", "font": "DM Sans / ABC Diatype", "use": "Hero headlines" },
        "h1":      { "size": 30, "weight": 700, "line_height": 1.2,  "tracking": "0px",    "font": "ABC Diatype", "use": "Utility/legal page titles" },
        "h2":      { "size": 24, "weight": 500, "line_height": 1.4,  "tracking": "0.12px", "font": "ABC Diatype / DM Sans", "use": "Section headings" },
        "subhead": { "size": 20, "weight": 400, "line_height": 1.4,  "tracking": "0px",    "font": "ABC Diatype", "use": "Secondary headings, TOC" },
        "lead":    { "size": 18, "weight": 500, "line_height": 1.4,  "tracking": "0.12px", "font": "ABC Diatype", "use": "Lead / emphasis body" },
        "body":    { "size": 16, "weight": 400, "line_height": 1.4,  "tracking": "0.08px", "font": "ABC Diatype", "use": "Primary body" },
        "body-sm": { "size": 14, "weight": 400, "line_height": 1.5,  "tracking": "0.07px", "font": "DM Sans", "use": "Workhorse UI text — most common size" },
        "caption": { "size": 12, "weight": 400, "line_height": 1.5,  "tracking": "0.06px", "font": "DM Sans", "use": "Sub-labels, helper/meta text" },
        "eyebrow": { "size": 11, "weight": 600, "line_height": 1.0,  "tracking": "0.2em",  "font": "ABC Diatype", "transform": "uppercase", "use": "Kicker labels (10–12px, tracking 0.14em–0.25em)" },
        "micro":   { "size": 10, "weight": 400, "line_height": 1.4,  "font": "DM Sans", "use": "Dense table / artifact text" }
      }
    },

    "reports": {
      "_note": "Altis Reports PDFs and decks. Inter / Inter Tight are native Google Slides fonts that render in presentations without embedding, and print cleanly. Unchanged.",
      "primary_font": {
        "family": "Inter", "weights": [400, 500, 700], "use_for": "Body text, bullets, captions, UI labels, running prose",
        "google_fonts_url": "https://fonts.google.com/specimen/Inter",
        "note": "Native Google Slides font — renders correctly in presentations without embedding."
      },
      "heading_font": {
        "family": "Inter Tight", "weights": [500, 600, 700], "use_for": "Headlines, section headers, slide titles, bold display",
        "google_fonts_url": "https://fonts.google.com/specimen/Inter+Tight",
        "note": "Native Google Slides font — renders correctly in presentations without embedding."
      },
      "fallback_stack": "Inter, 'Inter Tight', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "email_fallback_stack": "Inter, Arial, Helvetica, sans-serif",
      "scales": {
        "display": { "size": 48, "weight": 700, "line_height": 1.1,  "font": "Inter Tight", "use": "Hero sections, major slide titles" },
        "h1":      { "size": 36, "weight": 700, "line_height": 1.15, "font": "Inter Tight", "use": "Page titles, report section headers" },
        "h2":      { "size": 28, "weight": 600, "line_height": 1.2,  "font": "Inter Tight", "use": "Section headings" },
        "h3":      { "size": 22, "weight": 600, "line_height": 1.25, "font": "Inter Tight", "use": "Sub-headings" },
        "h4":      { "size": 18, "weight": 600, "line_height": 1.3,  "font": "Inter Tight", "use": "Card titles, sidebar headings" },
        "body":    { "size": 16, "weight": 400, "line_height": 1.6,  "font": "Inter", "use": "Paragraphs, analysis text" },
        "small":   { "size": 14, "weight": 400, "line_height": 1.5,  "font": "Inter", "use": "Supporting text, footnotes" },
        "label":   { "size": 12, "weight": 500, "line_height": 1.4,  "font": "Inter", "letter_spacing": 0.02, "use": "Tags, badges, UI labels" },
        "caption": { "size": 11, "weight": 400, "line_height": 1.4,  "font": "Inter", "use": "Captions, timestamps" }
      }
    },

    "logo_font": {
      "family": "Neue Haas Grotesk Display Pro 65 (Medium)",
      "usage": "LOGO SVG ONLY — do not apply to any other text",
      "note": "The Altis wordmark is embedded as outlines in the logo SVG. Always use the logo SVG files."
    }
  },

  "spacing": {
    "unit": 4,
    "scale": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },
    "section_rhythm": "WEB: vertical section padding py-12 (48px) dominant, then py-16 (64px), py-24 (96px); horizontal gutter px-4 (16px)."
  },

  "layout": {
    "web": {
      "container_max_width": 1440,
      "container_classes": "w-full mx-auto px-4 max-w-[1440px]",
      "content_widths": [922, 986, 580, 512, 480],
      "note": "Readable content columns nest inside the 1440px container."
    }
  },

  "borders": {
    "web": {
      "radius": { "none": 0, "sm": 6, "md": 8, "lg": 16, "brand-md": 32, "brand-lg": 64, "full": 9999 },
      "default_radius": "md (8px) — cards, buttons, inputs, panels",
      "signature_radius": "brand-lg (64px) — oversized radius on large feature/hero surfaces"
    },
    "reports": {
      "radius": { "none": 0, "sm": 4, "md": 8, "lg": 16, "xl": 24, "full": 9999 }
    }
  },

  "buttons": {
    "web": {
      "_note": "No shared Button component in web-v2 — composed inline. Canonical: components/Paywalls/PaywallFooter.tsx.",
      "primary":        { "bg": "#015AE9", "text": "#FFFFFF", "radius": "full", "size": "h-12 px-6", "type": "text-sm font-medium tracking-[0.07px]", "hover": "opacity-90", "focus_ring": "#162840/40" },
      "secondary_dark": { "bg": "#030D1F", "text": "#F6F7FA", "radius": "md (8px)", "size": "px-2 py-1", "type": "font-dm-sans text-sm", "hover": "bg/90" },
      "neutral_light":  { "bg": "#E8EDF5", "text": "#030D1F", "radius": "md (8px)", "type": "font-dm-sans" },
      "destructive":    { "bg": "#B84040", "text": "#FFFFFF", "focus_ring": "#B84040/40" }
    }
  },

  "logo": {
    "primary": "assets/logos/altis-logo-primary.svg",
    "colorways_sheet": "assets/logos/altis-logo-colorways.svg",
    "variants": {
      "2c_positive": { "file": "assets/logos/altis-logo-2c-positive.svg", "description": "Dark mark + wordmark on white — primary use case", "backgrounds": ["white"] },
      "2c_reverse":  { "file": "assets/logos/altis-logo-2c-reverse.svg",  "description": "White mark + wordmark — for dark/blue backgrounds", "backgrounds": ["navy", "blue"] },
      "1c_positive": { "file": "assets/logos/altis-logo-1c-positive.svg", "description": "Single-color positive — print/single-color, light bg", "backgrounds": ["white", "light"] },
      "1c_reverse":  { "file": "assets/logos/altis-logo-1c-reverse.svg",  "description": "Single-color reverse — print/single-color, dark bg", "backgrounds": ["navy", "blue", "black"] }
    },
    "approved_backgrounds": ["white", "navy (#030F1F print / #030D1F web)", "blue (#015AE9)", "cyan", "black"],
    "min_clear_space": "Height of the chevron mark on all sides",
    "min_size_digital": "120px wide",
    "never": ["distort", "rotate", "recolor outside approved variants", "place on busy backgrounds"]
  },

  "graphic_library": {
    "construction_grid": "assets/construction-logic@2x.png",
    "construction_rule": "Use this grid (or variations on it) to create new shapes informed by our logo design",
    "icon_count": 16,
    "colorways": {
      "light": { "fill": "#015AE9", "background": "transparent (designed for white backgrounds)", "suffix": "-light" },
      "dark":  { "fill": "#FFFFFF", "background": "transparent (designed for navy/blue backgrounds)", "suffix": "-dark" }
    },
    "icons": {
      "signal":   { "svg_light": "assets/icons/icon-signal-light.svg",   "svg_dark": "assets/icons/icon-signal-dark.svg",   "description": "5 concentric arcs — signal strength / broadcast / reach" },
      "echo":     { "svg_light": "assets/icons/icon-echo-light.svg",     "svg_dark": "assets/icons/icon-echo-dark.svg",     "description": "2 half-arcs — echo / pulse pair" },
      "sweep":    { "svg_light": "assets/icons/icon-sweep-light.svg",    "svg_dark": "assets/icons/icon-sweep-dark.svg",    "description": "3 sweeping arcs from right — expand / reach" },
      "corner":   { "svg_light": "assets/icons/icon-corner-light.svg",   "svg_dark": "assets/icons/icon-corner-dark.svg",   "description": "L-shaped corner bracket — pivot / anchor" },
      "crescent": { "svg_light": "assets/icons/icon-crescent-light.svg", "svg_dark": "assets/icons/icon-crescent-dark.svg", "description": "Single crescent arc — curvature / potential" },
      "arc":      { "svg_light": "assets/icons/icon-arc-light.svg",      "svg_dark": "assets/icons/icon-arc-dark.svg",      "description": "Single wide arc — trajectory / path" },
      "horizon":  { "svg_light": "assets/icons/icon-horizon-light.svg",  "svg_dark": "assets/icons/icon-horizon-dark.svg",  "description": "Wide panoramic wave — landscape / scale" },
      "ring":     { "svg_light": "assets/icons/icon-ring-light.svg",     "svg_dark": "assets/icons/icon-ring-dark.svg",     "description": "3 arc ring segments — cycle / orbit" },
      "stack":    { "svg_light": "assets/icons/icon-stack-light.svg",    "svg_dark": "assets/icons/icon-stack-dark.svg",    "description": "5 stacked arcs — layers / depth / progress" },
      "quarter":  { "svg_light": "assets/icons/icon-quarter-light.svg",  "svg_dark": "assets/icons/icon-quarter-dark.svg",  "description": "Quarter-circle element — fragment / beginning" },
      "lens":     { "svg_light": "assets/icons/icon-lens-light.svg",     "svg_dark": "assets/icons/icon-lens-dark.svg",     "description": "Circular orbital shape — focus / insight" },
      "orbit":    { "svg_light": "assets/icons/icon-orbit-light.svg",    "svg_dark": "assets/icons/icon-orbit-dark.svg",    "description": "Crescent with orbital paths — rotation / movement" },
      "target":   { "svg_light": "assets/icons/icon-target-light.svg",   "svg_dark": "assets/icons/icon-target-dark.svg",   "description": "Circle with bracket crosshair — scope / precision" },
      "brackets": { "svg_light": "assets/icons/icon-brackets-light.svg", "svg_dark": "assets/icons/icon-brackets-dark.svg", "description": "Mirrored L-brackets — structure / contain" },
      "peak":     { "svg_light": "assets/icons/icon-peak-light.svg",     "svg_dark": "assets/icons/icon-peak-dark.svg",     "description": "4 concentric mountain arcs — elevation / summit" },
      "layers":   { "svg_light": "assets/icons/icon-layers-light.svg",   "svg_dark": "assets/icons/icon-layers-dark.svg",   "description": "6-path double nested arcs — depth / complexity" }
    }
  },

  "patterns": {
    "usage": "Background texture, section dividers, report covers — always at reduced opacity",
    "variants": {
      "light": { "svg": "assets/patterns/pattern-light.svg", "png_2x": "assets/patterns/pattern-light@2x.png", "description": "Brand icons on white background", "use_on": "white/light backgrounds" },
      "blue":  { "svg": "assets/patterns/pattern-blue.svg",  "png_2x": "assets/patterns/pattern-blue@2x.png",  "description": "Brand icons on brand blue (#015AE9) background", "use_on": "brand blue / navy backgrounds" }
    }
  },

  "photography": {
    "style": "Architectural, infrastructure, aspirational elevation",
    "treatment_options": ["untreated", "focus-effect (brand blue gradient overlay)"],
    "subjects": ["Mountain peaks", "Bridges and infrastructure", "Upward perspective views"],
    "assets": { "untreated": "assets/photos/photo-untreated.jpg", "focus_effect": "assets/photos/photo-focus-effect.jpg" }
  }
}
